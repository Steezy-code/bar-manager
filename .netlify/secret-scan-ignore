# Ignore placeholder environment variables in .env.example
^VITE_SUPABASE_URL=https://your-project\.supabase\.co$
^VITE_SUPABASE_ANON_KEY=your-anon-key$

# Ignore placeholder Supabase URLs in documentation
.*your-project.*supabase\.co
.*your-anon-key.*
.*your-project-id.*supabase\.co

# Ignore placeholder keys in source code
.*YOUR_SUPABASE_URL.*
.*YOUR_SUPABASE_ANON_KEY.*

# Ignore the placeholder project URL shown as an example in documentation.
# (The real project URL is injected via the VITE_SUPABASE_URL env var, which is
# exempted through SECRETS_SCAN_OMIT_KEYS in netlify.toml — and it is a public
# value anyway.) Scoped to the doc example host so a genuinely leaked URL still flags.
^.*abc123\.supabase\.co.*$